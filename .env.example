# Copy to .env (git-ignored). DEV-ONLY values; real environments supply their own secrets.
# docker compose reads .env; export it before `./mvnw spring-boot:run` (e.g. `set -a; . ./.env; set +a`).
DB_NAME=telecom_support
DB_USERNAME=telecom_app
DB_PASSWORD=change_me_dev_only
MYSQL_ROOT_PASSWORD=change_me_root_dev_only
DB_URL="jdbc:mysql://localhost:3306/telecom_support?characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
